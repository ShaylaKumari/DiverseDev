{
  "name": "WF01 -  Entrada de feedback",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = new Date();\n\nconst ano = data.getFullYear()\nconst mes = data.getMonth() + 1\n\nconst primeiroDiaDoMes = new Date(ano, data.getMonth(), 1)\nconst diaDoMes = data.getDate()\n\nconst semana_do_mes = Math.ceil(\n  (diaDoMes + primeiroDiaDoMes.getDay()) / 7\n)\n\nreturn {\n  json: {\n    ano,\n    mes,\n    semana_do_mes,\n    data_hora: data.toString(),\n    slug_empresa: $json.body.company_slug,\n    setor: $json.body.department,\n    tipo_informado: $json.body.feedback_type,\n    feedback: $json.body.feedback\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        128
      ],
      "id": "bedaa50d-db49-4951-a99a-0ece8c3880d6",
